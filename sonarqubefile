pipeline {
    agent any

    tools {
        sonarScanner 'SonarScanner'
    }

    stages {

        stage('SonarQube Code Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    bat '''
                    sonar-scanner ^
                    -Dsonar.projectKey=ram-sonar ^
                    -Dsonar.projectName=Ram-Sonar ^
                    -Dsonar.sources=.
                    '''
                }
            }
        }
    }
}
