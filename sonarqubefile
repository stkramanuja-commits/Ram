pipeline {
    agent any

    stages {

        stage('Clone Git Repository') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-creds',
                    url: 'https://github.com/stkramanuja-commits/Ram.git'
            }
        }

        stage('SonarQube Analysis using Docker') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    bat '''
                    docker run --rm ^
                      -v "%CD%:/usr/src" ^
                      sonarsource/sonar-scanner-cli ^
                      -Dsonar.projectKey=ram-sonar ^
                      -Dsonar.projectName=Ram-Sonar ^
                      -Dsonar.sources=/usr/src
                    '''
                }
            }
        }
    }
}
