pipeline {
    agent any

    stages {

        stage('Clone Git Repository') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-creds',
                    url: 'https://github.com/stkramanuja-commits/Ram.git'
            }
        }

        stage('SonarQube Code Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    bat '''
                    sonar-scanner ^
                    -Dsonar.projectKey=ram-sonar ^
                    -Dsonar.projectName=Ram-Sonar ^
                    -Dsonar.sources=.
                    '''
                }
            }
        }
    }
}
